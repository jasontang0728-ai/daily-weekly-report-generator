<view class="page-shell">
  <view class="hero-card">
    <view class="eyebrow">MY SPACE</view>
    <view class="page-title">我的</view>
    <view class="page-copy">历史记录与模板管理统一收在这里，主工作台保持专注。</view>
  </view>

  <block wx:for="{{entries}}" wx:key="title">
    <view class="section-block entry-card" data-path="{{item.path}}" bindtap="handleOpen">
      <view class="section-title">{{item.title}}</view>
      <view class="section-text">{{item.subtitle}}</view>
    </view>
  </block>
</view>
