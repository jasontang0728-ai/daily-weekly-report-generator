<view class="page-shell">
  <view class="plain-header plain-header-b">DAILY WORKSPACE</view>

  <view class="section-block workspace-panel">
    <view class="section-title">原始输入</view>
    <textarea
      class="raw-input"
      maxlength="{{limit}}"
      placeholder="{{hint}}"
      placeholder-style="color:#98a09f;line-height:1.75;"
      value="{{rawInput}}"
      bindinput="handleInput"
    />
    <view class="input-footer">
      <view class="section-text">{{rawInputCount}} / {{limit}}</view>
      <button class="compact-action-button" disabled="{{disableGenerate}}" bindtap="handleGenerate">AI整理</button>
    </view>
  </view>

  <view wx:if="{{document}}" class="section-block">
    <view class="section-title">生成结果预览</view>

    <block wx:if="{{!isEditing}}">
      <view class="preview-shell">
        <view wx:if="{{document.title}}" class="preview-title">{{document.title}}</view>
        <view wx:if="{{previewText}}" class="preview-text">{{previewText}}</view>
        <view wx:else class="preview-empty">暂时还没有生成内容</view>
      </view>
    </block>

    <block wx:if="{{isEditing}}">
      <block wx:for="{{editorSections}}" wx:key="order">
        <view class="editor-card">
          <view class="editor-title">{{item.name}}</view>
          <textarea
            class="editor-textarea"
            data-index="{{index}}"
            value="{{item.text}}"
            placeholder="每行一条事项"
            bindinput="handleEditorInput"
          />
        </view>
      </block>
      <button class="ghost-button single-button" bindtap="handleCancelEdit">取消编辑</button>
    </block>

    <view class="action-row">
      <button class="ghost-button" bindtap="handleEdit">编辑</button>
      <button class="primary-button" disabled="{{disableFinish}}" bindtap="handleFinish">完成</button>
    </view>
  </view>

  <view wx:if="{{popupVisible}}" class="popup-mask" bindtap="handlePopupClose">
    <view class="popup-card" catchtap="noop">
      <view class="popup-title">日报已保存</view>
      <view class="popup-content">{{popupText}}</view>
      <view class="popup-actions">
        <button class="ghost-button" bindtap="handlePopupClose">关闭</button>
        <button class="primary-button" bindtap="handlePopupCopy">一键复制</button>
      </view>
    </view>
  </view>
</view>
