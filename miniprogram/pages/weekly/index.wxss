@import "../../app.wxss";

.plain-header {
  margin: 4rpx 0 12rpx;
  text-align: center;
  text-transform: uppercase;
}

.plain-header-b {
  color: #8a7d6d;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.workspace-panel {
  margin-top: 10rpx;
}

.compact-action-button {
  display: inline-block;
  min-width: 204rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #efe8dd 0%, #e5ddd0 100%);
  border: 2rpx solid rgba(151, 142, 128, 0.22);
  color: #7d756a;
  font-size: 24rpx;
  line-height: 64rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(116, 108, 93, 0.1);
}

.weekly-action-button {
  align-self: center;
}

.single-button {
  margin-top: 18rpx;
}

.editor-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fffcf6;
}

.editor-title {
  color: #8a7d6d;
  font-size: 30rpx;
  font-weight: 700;
}

.editor-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fff7eb;
}

.preview-shell {
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 250, 241, 0.92);
  box-shadow: 0 20rpx 60rpx rgba(84, 63, 36, 0.06);
}

.preview-title {
  color: #8a7d6d;
  font-size: 34rpx;
  font-weight: 700;
}

.preview-text {
  margin-top: 20rpx;
  color: #7d7a73;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.preview-empty {
  color: #7d7a73;
  font-size: 28rpx;
  line-height: 1.7;
}

.popup-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(23, 30, 27, 0.38);
  z-index: 99;
}

.popup-card {
  width: 100%;
  max-height: 80vh;
  overflow: auto;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fffaf1;
}

.popup-title {
  color: #8a7d6d;
  font-size: 34rpx;
  font-weight: 700;
}

.popup-content {
  margin-top: 20rpx;
  color: #7d7a73;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.popup-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
