@import "../../app.wxss";

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.meta-pill {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f6efe0;
  color: #4b554f;
  font-size: 24rpx;
}

.single-button {
  margin-top: 22rpx;
}

.editor-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fffcf6;
}

.editor-title {
  color: #16372b;
  font-size: 30rpx;
  font-weight: 700;
}

.editor-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fff7eb;
}
