@import "../../app.wxss";

.template-list {
  margin-top: 28rpx;
}

.template-card {
  margin-top: 20rpx;
  transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease, border-color 180ms ease;
}

.template-card:first-child {
  margin-top: 0;
}

.template-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.template-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.template-index {
  color: #a19586;
  font-size: 24rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.template-name {
  margin-left: 16rpx;
  color: #8a7d6d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-edit {
  margin-left: 16rpx;
  color: #9a8f80;
  font-size: 24rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.template-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.template-delete {
  color: #ad8f7b;
  font-size: 24rpx;
  line-height: 1.4;
}

.template-drag-handle {
  margin-left: 20rpx;
  padding: 6rpx 10rpx;
  border-radius: 12rpx;
  color: #b3a795;
  font-size: 30rpx;
  line-height: 1;
}

.is-dragging {
  z-index: 10;
  opacity: 0.96;
  box-shadow: 0 24rpx 60rpx rgba(84, 63, 36, 0.14);
}

.is-drop-target {
  border: 2rpx solid rgba(154, 143, 128, 0.32);
  background: rgba(255, 248, 236, 0.96);
}

.single-button {
  margin-top: 20rpx;
}
