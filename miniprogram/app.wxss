page {
  min-height: 100%;
  background: linear-gradient(180deg, #f3efe4 0%, #efe7d7 100%);
  color: #1f2a24;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 250, 241, 0.92);
  box-shadow: 0 20rpx 60rpx rgba(84, 63, 36, 0.08);
}

.eyebrow {
  color: #7e7361;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.page-title {
  margin-top: 12rpx;
  color: #16372b;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-copy {
  margin-top: 18rpx;
  color: #5c665f;
  font-size: 28rpx;
  line-height: 1.6;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.ghost-button,
.primary-button {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

.ghost-button {
  background: #f6efe0;
  color: #1e4d3b;
  border: 2rpx solid #d8c8ab;
}

.primary-button {
  background: #1e4d3b;
  color: #fffaf1;
}

.section-block {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 250, 241, 0.82);
}

.section-title {
  color: #1e4d3b;
  font-size: 30rpx;
  font-weight: 700;
}

.section-text {
  margin-top: 14rpx;
  color: #4d5951;
  font-size: 27rpx;
  line-height: 1.7;
}
