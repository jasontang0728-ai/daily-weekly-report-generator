page {
  min-height: 100%;
  background: linear-gradient(180deg, #f3efe4 0%, #efe7d7 100%);
  color: #7d7a73;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 250, 241, 0.92);
  box-shadow: 0 20rpx 60rpx rgba(84, 63, 36, 0.08);
}

.eyebrow {
  color: #8a7d6d;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.page-title {
  margin-top: 12rpx;
  color: #8a7d6d;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-copy {
  margin-top: 18rpx;
  color: #7d7a73;
  font-size: 28rpx;
  line-height: 1.6;
}

.action-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 28rpx;
}

.ghost-button,
.primary-button {
  flex: none;
  min-width: 152rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #efe8dd 0%, #e5ddd0 100%);
  color: #7d756a;
  border: 2rpx solid rgba(151, 142, 128, 0.22);
  box-shadow: 0 10rpx 24rpx rgba(116, 108, 93, 0.10);
}

.section-block {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 250, 241, 0.82);
}

.section-title {
  color: #8a7d6d;
  font-size: 30rpx;
  font-weight: 700;
}

.section-text {
  margin-top: 14rpx;
  color: #7d7a73;
  font-size: 27rpx;
  line-height: 1.7;
}
