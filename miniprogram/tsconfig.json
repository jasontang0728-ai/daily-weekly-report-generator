{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "miniprogram-api-typings"
    ]
  },
  "include": [
    "app.ts",
    "pages/**/*.ts",
    "typings/**/*.d.ts"
  ]
}
