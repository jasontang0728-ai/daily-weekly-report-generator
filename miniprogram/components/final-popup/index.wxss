@import "../../app.wxss";

.popup-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(23, 30, 27, 0.38);
  z-index: 99;
}

.popup-card {
  width: 100%;
  max-height: 80vh;
  overflow: auto;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fffaf1;
}

.popup-title {
  color: #16372b;
  font-size: 34rpx;
  font-weight: 700;
}

.popup-content {
  margin-top: 20rpx;
  color: #33423b;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.popup-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
