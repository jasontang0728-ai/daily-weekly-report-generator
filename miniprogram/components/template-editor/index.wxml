<view class="template-shell">
  <block wx:for="{{sections}}" wx:key="id">
    <view class="section-block template-card">
      <view class="template-meta">
        <view class="template-order">栏目 {{index + 1}}</view>
        <view class="template-name">{{item.name}}</view>
      </view>
      <view class="template-action-stack">
        <button class="ghost-button template-action-button" data-id="{{item.id}}" bindtap="handleRename">
          编辑栏目
        </button>
        <button
          class="ghost-button template-action-button"
          data-index="{{index}}"
          bindtap="handleMoveUp"
          disabled="{{index === 0}}"
        >
          上移一位
        </button>
        <button
          class="ghost-button template-action-button"
          data-index="{{index}}"
          bindtap="handleMoveDown"
          disabled="{{index === sections.length - 1}}"
        >
          下移一位
        </button>
        <button
          class="ghost-button template-action-button danger-button"
          data-id="{{item.id}}"
          bindtap="handleRemove"
          disabled="{{sections.length <= 1}}"
        >
          删除栏目
        </button>
      </view>
    </view>
  </block>

  <button class="primary-button template-action-button template-add-button" bindtap="handleAdd">
    新增栏目
  </button>
</view>
